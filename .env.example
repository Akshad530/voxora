# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Must match EXPO_PUBLIC_APP_TOKEN in the app's .env
APP_TOKEN=change-me
PORT=8787
# Models are configurable because providers rename/deprecate them.
GROQ_STT_MODEL=whisper-large-v3
GROQ_LLM_MODEL=llama-3.3-70b-versatile
MAX_UPLOAD_MB=25
